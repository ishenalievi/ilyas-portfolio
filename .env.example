# The keys the site uses, with no values. The real ones live in .env on the Mac
# (never committed) and in Vercel → Project → Settings → Environment Variables.
# `npm run dev` needs none of them.

# Site editor (/keystatic) on the live site: GitHub sign-in
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# public: the GitHub app's name, shown in the editor
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# "Now spinning" on Home. Get them with `npm run dev` → http://127.0.0.1:3000/api/spotify/connect
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
